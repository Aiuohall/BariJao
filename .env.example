# Copy this file to ".env" and fill in real values. NEVER commit your real .env.
# Leaving the Supabase variables empty makes the app run on a local, self-contained
# SQLite database (no external service required).

# --- Database (optional) ---
# To use Supabase (persistent Postgres), set these. If left empty, SQLite is used.
SUPABASE_URL=
SUPABASE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Google Gemini AI (optional) ---
# Powers the "generate listing description" feature. Leave empty to disable it.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
VITE_GOOGLE_AI_API_KEY=

# --- Email (OTP delivery) ---
# Pick ONE of the two options below. If neither is set, no email is sent and the
# OTP is only printed to the server console (the app will say so on the OTP screen).
# Check what the server actually picked up at:  GET /api/health  ->  "email"

# Option 1 (RECOMMENDED, works on Render/Vercel/etc.): Brevo HTTP API.
#   1. Create a free account at https://www.brevo.com
#   2. Add and verify a sender address under "Senders, Domains & Dedicated IPs"
#   3. Create an API key under SMTP & API -> API Keys, and paste it here
# Brevo sends over HTTPS, so it works even where outbound SMTP ports are blocked.
BREVO_API_KEY=
# Must be an address verified in Brevo (falls back to the address in EMAIL_FROM).
BREVO_SENDER=

# Option 2: SMTP (e.g. Gmail with an "App Password"). Requires 2-Step Verification
# on your Google account, then create one at https://myaccount.google.com/apppasswords
# NOTE: most free hosts block outbound SMTP, so this often works locally but not
# once deployed. Paste the app password with or without spaces — spaces are stripped.
SMTP_USER=
SMTP_PASS=
# Advanced: to use a non-Gmail provider, also set SMTP_HOST / SMTP_PORT / SMTP_SECURE.

# Shown as the "From" on the OTP email. Used by both options.
EMAIL_FROM=BariJao <your-gmail@gmail.com>

# --- Auth ---
# A long random string used to sign login tokens. Generate your own.
JWT_SECRET=change_me_to_a_long_random_string

# --- Server ---
PORT=3000
